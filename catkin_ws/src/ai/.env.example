# Copy to .env and fill in. Env vars override values from the YAML config files.
# Naming: AI_<SECTION>_<KEY> maps to the YAML key <section>.<key> (see ai_common/config.py).

# --- ai_common (ai_common/config/common.yaml) ---
# Robot identifier sent with every backend event.
AI_ROBOT_ID=nurse-01
# DEBUG | INFO | WARNING | ERROR | CRITICAL
AI_LOG_LEVEL=INFO
# Root folder for videos, rosbags, audio and datasets (kept outside git).
AI_DATA_DIR=/data/ai

# --- ai_follow (ai_follow/config/follow.yaml), prefix AI_FOLLOW_ ---
# Camera intrinsics [px] and distance constant d = k / bbox_height_px. Calibrate in T1.3.
# AI_FOLLOW_FX=500.0
# AI_FOLLOW_CX=320.0
# AI_FOLLOW_DISTANCE_K=600.0
# Must equal moving_server person_tracking.follow_distance.
# AI_FOLLOW_FOLLOW_DISTANCE_M=1.0

# --- LLM (used from T0.4 on; leave empty until then) ---
# OPENAI_API_KEY=
# LLM_MODEL=
